# ── ST SOCIAL environment ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets. The frontend never
# sees any of these values.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATA_DIR=./data
DB_FILE=./data/stsocial.db

# Auth
AUTH_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MS=2592000000            # 30 days

# Ingest API key used by approved external systems pushing to /api/ingest/*
INGEST_API_KEY=change-me-ingest-key

# University email domains that auto-verify a student badge
VERIFIED_EMAIL_DOMAINS=st-andrews.ac.uk,students.st-andrews.ac.uk,ac.st-andrews.ac.uk

# Aggregation
STSSOCIAL_DEMO_MODE=true              # true = clearly-labelled DEMO DATA (default)
STSSOCIAL_LIVE_SOURCES=false         # true = adapters attempt real fetches
INGEST_INTERVAL_MS=300000            # re-run ingestion every 5 minutes
DEMO_ALIVE_INTERVAL_MS=90000         # demo "always alive" sample-event ticker

# CORS (if you ever split the API from the frontend)
CORS_ORIGIN=*
